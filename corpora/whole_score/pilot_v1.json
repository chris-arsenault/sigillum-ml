{
  "schema_version": 1,
  "dataset_id": "whole_score_observation_pilot_v1",
  "observation_schema_version": 1,
  "data_root": "assets/raw/corpus/whole_score",
  "output_root": "outputs/datasets/whole_score/pilot_v1",
  "training_targets": {
    "representation": [
      "structural_relationships",
      "material_identity",
      "phrase_and_section_context",
      "seam_context",
      "candidate_to_original_change"
    ],
    "criterion_specific_critics": [
      "coherence",
      "identity",
      "seams",
      "orchestration",
      "reserve"
    ],
    "ruby_authoritative_auxiliaries": [
      "mechanical_validity",
      "requirement_binding"
    ],
    "excluded_targets": [
      "raw_note_prediction_as_the_only_objective",
      "one_composite_quality_score",
      "agent_or_deterministic_origin_as_positive_reward"
    ]
  },
  "split_policy": {
    "key": "composition_lineage",
    "rule": "Every movement and alternate encoding of one work stays in one split. Held-out evaluation preferences are excluded from training independently of this score-corpus split."
  },
  "collections": [
    {
      "id": "openscore_orchestra_gold",
      "source_id": "openscore_orchestra",
