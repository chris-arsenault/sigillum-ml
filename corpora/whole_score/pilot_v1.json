      ],
      "expected_score_count": 94,
      "annotation_rules": [
        {
          "kind": "hauptstimme_annotations",
          "patterns": ["{directory}/{stem}_annotations.csv"]
        },
        {
          "kind": "part_relations",
          "patterns": ["{directory}/{stem}_part_relations.csv"]
        },
        {
          "kind": "prominent_line_score",
          "patterns": ["{directory}/{stem}_melody.mxl"]
        }
      ],
      "lineages": [
